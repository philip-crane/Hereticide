# Unity3D generated meta files
*.pidb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Build results
Build/
Builds/
[Bb]uild/
[Bb]uilds/
Assets/StreamingAssets/

# MemoryCaptures
MemoryCaptures/

# Persistent functor files
Functors/

# Crash reports
CrashReports/

# Packed Addressables
Library/com.unity.addressables/

# Installed packages
Library/PackageCache/

# Packages
Packages/*

# Uncomment if you have tasks related to custom package work
# Packages/com.unity.my-custom-package/

# Collaborate
.collabignore

# Ignore JetBrains Rider project files
.idea/
*.sln.iml

# Ignore specific problematic file
Library/PackageCache/com.unity.burst@*/.Runtime/libburst-llvm-*.dylib
